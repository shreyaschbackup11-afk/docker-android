{
  "name": "docker-android",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "forwardPorts": [5555],
  "portsAttributes": {
    "5555": {
      "label": "ADB (Android Debug Bridge)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "docker build -t android-emulator ."
}
